# ══════════════════════════════════════════════════════════════════════════════
# SuperMLX configuration reference
#
#   cp .env.example .env     then edit what you need.
#
# Every variable is optional except MODEL_PATH. Lines starting with '#' show the
# built-in default; uncomment one to change it. Booleans: true/false.
# The single source of truth for types and defaults is supermlx/config.py.
# ══════════════════════════════════════════════════════════════════════════════


# ── MODEL ─────────────────────────────────────────────────────────────────────

# Hugging Face repo id or local path of the MLX model to serve. Only this variable is needed to start.
MODEL_PATH=mlx-community/Qwen3.5-9B-4bit

# Forces the tool-call/chat-template family: qwen3 | glm4 | gemma4 | deepseek | hermes | generic. Normally inferred from MODEL_PATH.
# MODEL_FAMILY=   (inferred from MODEL_PATH)

# Model id advertised by the API (/v1/models and responses).
# PROXY_MODEL_ID=openai/<MODEL_PATH>

# true = load a vision-language model as text-only (faster, less RAM).
# FORCE_TEXT_MODE=false


# ── NETWORK ───────────────────────────────────────────────────────────────────

# Interface the main API binds to. Use 127.0.0.1 to keep it local.
# MLX_HOST=0.0.0.0

# Port of the main OpenAI/Anthropic-compatible API.
# MLX_PORT=8080

# Port of the lightweight sidecar endpoint for non-agent queries (0 = disabled). Shares the loaded model.
# SIDECAR_PORT=8081

# Max tokens per sidecar response. Keep low: a sidecar call holds the model lock.
# SIDECAR_MAX_TOKENS=16384

# true = enrich sidecar requests with RAG context (needs the RAG section enabled).
# SIDECAR_ENABLE_RAG=true

# L2 distance threshold for sidecar RAG hits. Lower = stricter.
# SIDECAR_RAG_THRESHOLD=1.4


# ── GENERATION DEFAULTS ───────────────────────────────────────────────────────
# Used when the HTTP request does not specify the value.

# Max tokens generated per request.
# DEFAULT_MAX_TOKENS=2048

# Base sampling temperature.
# DEFAULT_TEMPERATURE=0.6

# Nucleus sampling top_p (1.0 = off).
# DEFAULT_TOP_P=0.95

# top_k (0 = off).
# DEFAULT_TOP_K=20

# min_p filter (0 = off).
# DEFAULT_MIN_P=0.0

# Repetition penalty (1.0 = off).
# DEFAULT_REPETITION_PENALTY=1.1

# Number of recent tokens the repetition penalty looks at.
# DEFAULT_REPETITION_CONTEXT_SIZE=64

# Presence penalty (0 = off).
# DEFAULT_PRESENCE_PENALTY=0.0

# Number of recent tokens the presence penalty looks at.
# DEFAULT_PRESENCE_CONTEXT_SIZE=20


# ── THINKING ──────────────────────────────────────────────────────────────────

# true = <think> blocks enabled unless the request says otherwise.
# DEFAULT_THINKING=true

# Max tokens inside <think> before the server forces the transition to the answer (0 = unlimited).
# MAX_THINKING_TOKENS=4096

# v2 = logits forcing (keeps the KV cache consistent); v1 = break and inject text.
# THINKING_BUDGET_MODE=v1

# true = keep previous <think> blocks in the conversation history sent back to the model.
# PRESERVE_THINKING=true

# Temperature used inside <think> when the schedule is disabled.
# THINKING_TEMPERATURE=0.5

# true = use THINKING_TEMP_SCHEDULE (stepped cooling) instead of a fixed thinking temperature.
# THINKING_SCHEDULE_ENABLED=false

# Comma-separated 'from_token:temperature' steps, e.g. 0:0.80,256:0.60 (used when the schedule is enabled).
# THINKING_TEMP_SCHEDULE=0:0.80,256:0.60,1024:0.35,3000:0.10


# ── RESPONSE TEMPERATURE ──────────────────────────────────────────────────────
# The model is asked to open its answer with a tag [TASK: CODE|TECH|PROSE|CREATIVE]; the tag selects the temperature.

# Fallback when the answer has no valid [TASK: ...] tag.
# RESPONSE_TEMPERATURE=0.3

# [TASK: CODE] - code, math, strict syntax.
# TEMP_RESP_CODE=0.1

# [TASK: TECH] - architecture, design, analysis.
# TEMP_RESP_TECH=0.3

# [TASK: PROSE] - dialogue, fluent prose.
# TEMP_RESP_PROSE=0.65

# [TASK: CREATIVE] - brainstorming, free ideation.
# TEMP_RESP_CREATIVE=0.85

# Temperature for any request that includes tools (overrides the tag).
# TOOL_CALLING_TEMPERATURE=0.1

# Temperature for conversation-compaction (summary) requests.
# COMPACTION_TEMPERATURE=0.2


# ── KV CACHE ──────────────────────────────────────────────────────────────────

# Maximum KV cache length in tokens. Higher = more context, more RAM.
# MAX_KV_SIZE=196608

# KV cache quantization: OFF, or 4 / 8 bits.
# KV_BITS=OFF

# Quantization group size (only when KV_BITS is set).
# KV_GROUP_SIZE=64

# Quantization scheme name passed to mlx-lm (only when KV_BITS is set).
# KV_QUANT_SCHEME=uniform

# Token index from which the KV cache starts being quantized.
# QUANTIZED_KV_START=0


# ── PROMPT CACHE ──────────────────────────────────────────────────────────────

# Max prompt-cache entries kept in the global LRU cache. Each entry holds a full KV cache (large).
# PROMPT_CACHE_MAX_ENTRIES_GLOBAL=2

# Max entries per session.
# PROMPT_CACHE_MAX_ENTRIES_PER_SESSION=2

# Time-based expiry of cache entries in seconds (0 = never expire).
# PROMPT_CACHE_TTL_SECONDS=0

# Idle time after which a session is forgotten. Metadata only; does not free KV memory.
# PROMPT_CACHE_SESSION_MAX_IDLE_SECONDS=1800

# Token block size of the LRU cache block index (minimum 16).
# PROMPT_CACHE_BLOCK_SIZE=16

# true = normalize tool context in the cache key so equivalent prompts share a prefix.
# CACHE_CANONICALIZE_TOOL_CONTEXT=true

# true = verify that the normalized cache key still matches the real prompt (slower, safer).
# CACHE_NORM_SAFETY_CHECK=false

# true = normalize file-content arguments of write tools before caching.
# NORMALIZE_WRITE_TOOL_CONTENT_FOR_PROMPT=false

# File where the warm-up cache is persisted across restarts (empty = disabled).
# CACHE_PERSIST_PATH=


# ── PREFILL ───────────────────────────────────────────────────────────────────

# Base prefill chunk size in tokens (adapted dynamically).
# PREFILL_STEP_SIZE=256

# Overflow guard: a prefill above this is rejected so the client compacts its history.
# MAX_SAFE_PREFILL_TOKENS=82192

# Milliseconds to sleep between prefill chunks so the GPU stays responsive (0 = off).
# GPU_YIELD_MS=0.0

# Tokens of pending prefill above which the MoE expert cache shrinks to make room.
# BREATHE_DOWN_REST_THRESHOLD=15000


# ── MEMORY (Metal) ────────────────────────────────────────────────────────────
# Sizes assume Apple Silicon unified memory. Defaults are derived from the device; override only if needed.

# Active Metal memory (GB) above which cache entries are evicted before prefill (0 = disabled).
# MEMORY_GUARD_THRESHOLD_GB=   (total RAM - 8)

# Metal memory (GB) above which compaction requests free memory first.
# MEMORY_COMPACT_THRESHOLD_GB=21.0

# Override of the Metal working-set budget in GB (auto-detected when unset).
# METAL_BUDGET_GB=   (auto-detected)

# Fraction of the working set kept free for KV growth and scratch.
# METAL_WIRED_RESERVE_FRACTION=0.15

# Max MLX buffer cache as a fraction of total device memory.
# METAL_CACHE_LIMIT_FRACTION=0.25

# Trigger memory relief when projected usage exceeds this fraction of the budget.
# METAL_PREFILL_RELIEF_THRESHOLD=0.9

# Skip memory relief for prefills smaller than this many tokens.
# METAL_PREFILL_RELIEF_MIN_TOKENS=1000

# Only clear the MLX cache when it exceeds this fraction of device memory.
# METAL_CLEANUP_CACHE_THRESHOLD=0.1

# Estimated scratch memory needed during prefill (GB).
# METAL_SCRATCH_ESTIMATE_GB=1.5

# KV bytes per token at fp16, used to estimate prefill memory (65536 fits Qwen3.6-class models).
# PREFILL_KV_BYTES_PER_TOKEN_FP16=65536

# Scratch memory (GB) reserved when sizing the radix KV cache budget.
# RADIX_SCRATCH_RESERVE_GB=1.5


# ── MOE EXPERT CACHE ──────────────────────────────────────────────────────────
# Only for MoE models. Off by default: experts run natively in MLX.

# true = predictive expert caching (lazy loading + dynamic swap).
# ENABLE_MOE_CACHE=false

# Max experts resident per MoE layer (0 = auto from free RAM).
# MOE_EXPERT_CAPACITY=100

# Capacity to grow to after warm-up (0 = no expansion).
# MOE_TARGET_CAPACITY=0

# JSON expert-frequency profile used to pin experts, e.g. profiles/qwen36_coding_profile.json.
# MOE_EXPERT_PROFILE=


# ── MULTI-TOKEN PREDICTION (MTP) ──────────────────────────────────────────────
# Speculative decoding with the model's MTP head. Needs the MTP weights.

# true = enable MTP speculative decoding.
# ENABLE_MTP=false

# Directory with the MTP weights and config.
# MTP_WEIGHTS_PATH=models/Qwen3.6-35B-A3B-MTP-MLX

# true = speculative sampling follows the current thinking/response temperature.
# MTP_ADAPTIVE_TEMPERATURE=true


# ── LOOP PROTECTION ───────────────────────────────────────────────────────────

# true = detect verbatim repeated n-gram loops during generation.
# NGRAM_LOOP_DETECTION=false

# Tokens per n-gram pattern.
# NGRAM_SIZE=35

# Repeats of a pattern tolerated before acting.
# NGRAM_MAX_REPEATS=12

# How many recent tokens are searched for repeats.
# NGRAM_WINDOW=400

# Check for loops every N generated tokens.
# NGRAM_CHECK_INTERVAL=32

# true = inject a steering thought instead of cutting the generation immediately.
# NGRAM_NUDGE_ENABLED=true

# Tokens to wait after a nudge before applying the hard break.
# NGRAM_GRACE_TOKENS=256

# Text injected into the thinking when a loop is detected.
# NGRAM_NUDGE_TEXT=[ATENCIÓN: ¡ESTOY EN LOOP! Debo salir ya. Hago Grounding: audito mis premisas comprobadas, descarto hipótesis circulares y cambio la dirección de mi razonamiento hacia la conclusión final.]

# true = break repeated identical tool-call loops.
# TOOL_LOOP_BREAKER=true

# Identical tool calls tolerated before the breaker acts.
# TOOL_LOOP_MAX_RETRIES=3


# ── THINKING STEERING ─────────────────────────────────────────────────────────
# Text injected into the KV cache while the model is thinking.

# true = periodically inject a rigor-check pause during thinking.
# FEATURE_EPISTEMIC_NUDGE=true

# Thinking tokens between pauses.
# EPISTEMIC_NUDGE_INTERVAL=2000

# Thinking tokens before the first pause is allowed.
# EPISTEMIC_NUDGE_MIN_TOKENS=1500

# Text injected at each pause.
# EPISTEMIC_NUDGE_TEXT=

[PAUSA DE RIGOR EPISTEMOLÓGICO]


# Thinking tokens between closure evaluations (decide whether to answer now).
# CLOSURE_NUDGE_INTERVAL=15000

# Text injected at each closure evaluation.
# CLOSURE_NUDGE_TEXT=[CRÍTICO: EVALUACIÓN DE CIERRE]  SI RESUELTO ->  [RESPUESTA FINAL YA!!]   SI NO RESUELTO -> [PAUSA DE RIGOR EPISTEMOLÓGICO]

# true = short temperature pulses during thinking to escape attractor loops.
# FEATURE_THINKING_THERMAL_SPARK=true

# Thinking tokens before sparks are allowed.
# SPARK_MIN_TOKENS_THRESHOLD=1200

# Tokens between periodic sparks.
# SPARK_PERIODIC_INTERVAL=1500

# Length of each spark in tokens.
# SPARK_PULSE_DURATION=35

# Temperature during a spark.
# SPARK_TEMPERATURE=0.88

# min_p safety filter during a spark.
# SPARK_MIN_P=0.05

# Minimum tokens between two sparks.
# SPARK_COOLDOWN_TOKENS=250


# ── TOOL CALLING & AGENT CLIENTS ──────────────────────────────────────────────

# true = repair malformed tool calls and messages in the conversation pipeline.
# HEALING=true

# true = replace a Hermes client's generic summarization prompt with the structured compact prompt.
# HERMES_COMPACT_SWAP=false

# true = keep KV state across consecutive housekeeping requests of a Hermes session.
# FEATURE_HOUSEKEEPING_STAGING=false

# Seconds before a staged housekeeping state rolls back to the base cache.
# HOUSEKEEPING_STAGING_TTL_SECONDS=300.0

# Max concurrent sessions in housekeeping staging.
# HOUSEKEEPING_STAGING_MAX_ENTRIES=2

# true = housekeeping requests may borrow the main KV cache.
# HOUSEKEEPING_CACHE_BORROW=true

# Max tokens of a compaction call itself (must stay below the OOM limit).
# MAX_SAFE_COMPACT_TOKENS=35000

# Most recent messages preserved verbatim when compacting.
# COMPACT_PRESERVE_TAIL=4

# Characters of accumulated summary before forcing a consolidation (~4k tokens).
# MAX_FROZEN_SUMMARY_CHARS=16000


# ── RAG & PROMPT COMPRESSION ──────────────────────────────────────────────────
# Optional. Requires the extras: pip install 'supermlx[rag]'.

# true = enrich prompts with retrieved context (LanceDB + embeddings).
# FEATURE_RAG_ENRICHMENT=false

# Directory indexed for RAG.
# RAG_WORKSPACE_ROOT=

# true = rebuild the RAG index at every startup.
# RAG_FORCE_REINDEX=false

# true = compress long histories with LLMLingua-2 before prefill.
# FEATURE_COMPRESSOR=false

# Prompt tokens above which compression applies.
# COMPRESSION_THRESHOLD=6000

# Most recent messages that are never compressed.
# COMPRESSION_GUARD=6


# ── APPLE NEURAL ENGINE (experimental) ────────────────────────────────────────

# true = offload prefill to the Apple Neural Engine. Experimental.
# ENABLE_ANE=false

# Comma-separated sequence-length buckets of the precompiled ANE models.
# ANE_PREFILL_BUCKETS=64,128,256


# ── LOGGING & DIAGNOSTICS (advanced) ──────────────────────────────────────────
# Useful for debugging; some write a lot of data to disk.

# Directory for logs (relative to the repo root).
# LOG_ROOT=logs

# true = write a per-session transcript log of requests and cache activity under LOG_ROOT.
# ENABLE_REQUEST_LOGGING=true

# true = dump prompts/messages to LOG_ROOT/requests/.
# LOG_PROMPTS=true

# true = include tool schemas and tool results in the request logs.
# LOG_TOOLS=true

# true = verbose logging of the vision-model cache path.
# VLM_CACHE_DEBUG=false

# true = before/after snapshots on every cache mutation.
# FEATURE_CACHE_DIAG=true

# true = snapshot Metal memory at pipeline checkpoints into LOG_ROOT/memory_profile/.
# FEATURE_MEMORY_PROFILER=false

# true = record which experts fire per layer (source data for MOE_EXPERT_PROFILE).
# EXPERT_ROUTING_LOG=false

# true = log raw model output -> extracted -> delivered tool calls.
# TOOL_AUDIT_LOG=false
