# SuperMLX — Environment Configuration Example
# Copy this file to .env and adjust values for your setup.
# .env is gitignored and never committed.

# ─── MODEL ────────────────────────────────────────────────────────────────────
MODEL_PATH=mlx-community/Qwen3.5-9B-4bit
# MODEL_PATH=mlx-community/gemma-4-e4b-it-4bit
# MODEL_PATH=/path/to/local/model

# Force text-only mode (skip VLM detection, faster load for text models)
FORCE_TEXT_MODE=true

# Model family override (auto-detected from MODEL_PATH by default)
# Options: qwen3 | hermes | glm4 | gemma4 | deepseek | generic
# MODEL_FAMILY=qwen3

# ─── PORTS ────────────────────────────────────────────────────────────────────
MLX_PORT=8080          # Direct MLX endpoint
PROXY_PORT=4000        # LiteLLM proxy endpoint (point OpenClaw / Claude Code here)
SIDECAR_PORT=8081      # Lightweight sidecar for external tools (0 = disabled)

# ─── KV CACHE ─────────────────────────────────────────────────────────────────
# Max tokens in KV cache per session (default: 196608 = 192K)
MAX_KV_SIZE=196608

# Max LRU entries in global cache (2 = safe for 24GB M4 Pro)
PROMPT_CACHE_MAX_ENTRIES_GLOBAL=2

# How long a cache entry lives before expiry (seconds). Default: 3600 (1h)
PROMPT_CACHE_TTL_SECONDS=3600

# How long a session can be idle before removed from session index (seconds)
PROMPT_CACHE_SESSION_MAX_IDLE_SECONDS=3600

# Cache reaper interval in seconds (default: 60). Lower for testing.
# Test setup: CACHE_REAPER_INTERVAL_SECONDS=30 + PROMPT_CACHE_TTL_SECONDS=120
CACHE_REAPER_INTERVAL_SECONDS=60

# ─── KV QUANTIZATION ──────────────────────────────────────────────────────────
# Native MLX KV quantization (optional). Set KV_BITS to enable.
# KV_BITS=4
# KV_QUANT_SCHEME=uniform
# QUANTIZED_KV_START=5000

# ─── MEMORY GUARD ─────────────────────────────────────────────────────────────
# GPU RAM threshold (GB) for pre-prefill cache eviction. Default: total_ram - 8GB.
# Set to 0 to disable. Recommended: 10.5 for 12GB, 19.2 for 24GB.
# MEMORY_GUARD_THRESHOLD_GB=10.5

# ─── CACHE PERSISTENCE (DPC) ──────────────────────────────────────────────────
# Dynamic Prefix Capture: auto-saves system prompt KV state to disk.
# Eliminates cold start (32s → <2s) on server restarts and after idle eviction.
CACHE_PERSIST_PATH=logs/warmup_cache.safetensors
EMBEDDED_CACHE_PERSIST_PATH=logs/embedded_cache.safetensors

# ─── RAG ENRICHMENT (optional) ────────────────────────────────────────────────
# Inject relevant codebase chunks into context. Requires lancedb + sentence-transformers.
FEATURE_RAG_ENRICHMENT=false
# RAG_WORKSPACE_ROOT=/path/to/your/workspace

# ─── PROMPT COMPRESSION (optional) ───────────────────────────────────────────
# LLMLingua-2 compression for long histories. Requires llmlingua.
FEATURE_COMPRESSOR=false
# COMPRESSION_THRESHOLD=10000

# Emergency compression: last-resort OOM defense for very long prompts.
EMERGENCY_CONTENT_COMPRESS=true
# MAX_SAFE_PREFILL_TOKENS=50000

# ─── GENERATION DEFAULTS ──────────────────────────────────────────────────────
DEFAULT_THINKING=false
# DEFAULT_TEMPERATURE=0.6
# DEFAULT_TOP_P=0.95
# DEFAULT_MAX_TOKENS=2048

# ─── SIDECAR ──────────────────────────────────────────────────────────────────
# Lightweight endpoint for external tools (shares loaded model, zero extra RAM at rest).
SIDECAR_MAX_TOKENS=16384
SIDECAR_ENABLE_RAG=false

# ─── CASCADE ROUTING (optional) ───────────────────────────────────────────────
# Forward to frontier API when local RAG confidence is low.
FEATURE_CASCADE=false
# CASCADE_API_URL=https://api.openai.com/v1
# CASCADE_API_KEY=sk-...
# CASCADE_MODEL=gpt-4o

# Tool call audit log: raw_model → extracted → delivered. Solo activar para debugear pipeline.
TOOL_AUDIT_LOG=false

# ─── MULTI-TOKEN PREDICTION (MTP) SPECULATIVE DECODING ────────────────────────
# Enable speculative decoding using trained 1-layer MTP head (Qwen 3.5 MoE / 35B)
ENABLE_MTP=false
MTP_WEIGHTS_PATH=models/Qwen3.6-35B-A3B-MTP-MLX
# Match speculative decoding temperature to active model phase (DualPhaseSampler & FEATURE_ADAPTIVE_TEMPERATURE)
MTP_ADAPTIVE_TEMPERATURE=true



# ─── THINKING TEMPERATURE SCHEDULE (Simulated Annealing Bucketizado) ─────────
# Activa el enfriamiento estocástico escalonado durante el bloque <think>.
# Al inicio (tokens bajos) usa temperatura alta para máxima exploración de hipótesis.
# Al converger (tokens altos) desciende a temperaturas bajas para deducción precisa y evitar bucles.
# Los samplers se pre-construyen una sola vez en el setup del request (0 overhead en hot-loop).
THINKING_SCHEDULE_ENABLED=false

# Formato: "min_tokens:temperatura,min_tokens:temperatura,..."
# Escalón 1 (0 a 255): 0.80 -> Exploración y apertura de hipótesis.
# Escalón 2 (256 a 1023): 0.60 -> Desarrollo analítico y deducción.
# Escalón 3 (1024 a 2999): 0.35 -> Convergencia y cálculo exacto.
# Escalón 4 (3000+): 0.10 -> Cierre determinista y prevención de overthinking/bucles.
THINKING_TEMP_SCHEDULE="0:0.80,256:0.60,1024:0.35,3000:0.10"

# Fallback continuo clásico (usado solo si THINKING_TEMP_SCHEDULE está vacío):
THINKING_TEMPERATURE=1.0
THINKING_TEMPERATURE_MIN=0.1
THINKING_COOLING_EXPONENT=3.0
THINKING_COOLING_FRACTION=0.25

# ─── RESPONSE DYNAMIC TASK TEMPERATURES ───────────────────────────────────────
TEMP_RESP_PRECISE=0.10
TEMP_RESP_EXPLAIN=0.50
TEMP_RESP_EXPLORE=0.85
